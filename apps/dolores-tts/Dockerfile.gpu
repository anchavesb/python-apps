FROM dolores-gpu-base:latest

# Install dolores-common first (shared lib)
COPY libs/dolores-common /app/libs/dolores-common
RUN pip install --no-cache-dir /app/libs/dolores-common

# Install dependencies only (stub package so pip can resolve pyproject.toml)
COPY apps/dolores-tts/pyproject.toml /app/
RUN mkdir -p /app/src/dolores_tts && \
    echo '__version__ = "0.0.0"' > /app/src/dolores_tts/__init__.py && \
    pip install --no-cache-dir ".[gpu]" && \
    rm -rf /app/src/dolores_tts

# Patch coqui-tts to fix ImportError with newer transformers
RUN sed -i 's/from transformers.pytorch_utils import isin_mps_friendly as isin/import torch; isin = lambda x: torch.backends.mps.is_available() and x.device.type == "mps"/' /usr/local/lib/python3.12/dist-packages/TTS/tts/layers/tortoise/autoregressive.py

# Copy actual source (fast — deps already cached in layer above)
COPY apps/dolores-tts/src /app/src
RUN pip install --no-cache-dir --no-deps .

# Create data directories
RUN mkdir -p /app/data/voices /app/models && chown -R appuser:appuser /app

USER appuser

EXPOSE 8002

# MUST use single worker due to CUDA/torch multiprocessing issues
CMD ["uvicorn", "dolores_tts.main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
