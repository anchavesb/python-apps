FROM dolores-gpu-base:python3.11

# Install dolores-common first (shared lib)
COPY libs/dolores-common /app/libs/dolores-common
RUN pip install --no-cache-dir /app/libs/dolores-common

# Install dependencies only (stub package so pip can resolve pyproject.toml)
COPY apps/dolores-stt/pyproject.toml /app/
RUN mkdir -p /app/src/dolores_stt && \
    echo '__version__ = "0.0.0"' > /app/src/dolores_stt/__init__.py && \
    pip install --no-cache-dir . && \
    rm -rf /app/src/dolores_stt

# Patch coqui-tts to fix ImportError with newer transformers (only if file exists)
RUN TTS_PATCH_FILE="/usr/local/lib/python3.11/dist-packages/TTS/tts/layers/tortoise/autoregressive.py"; \
    if [ -f "$TTS_PATCH_FILE" ]; then \
        sed -i 's/from transformers.pytorch_utils import isin_mps_friendly as isin/import torch; isin = lambda x: torch.backends.mps.is_available() and x.device.type == "mps"/' "$TTS_PATCH_FILE"; \
    fi

# Copy actual source (fast — deps already cached in layer above)
COPY apps/dolores-stt/src /app/src
RUN pip install --no-cache-dir --no-deps .

# Create model cache and data directories
RUN mkdir -p /app/models /app/data && chown -R appuser:appuser /app

USER appuser

EXPOSE 8001

CMD ["uvicorn", "dolores_stt.main:app", "--host", "0.0.0.0", "--port", "8001"]
